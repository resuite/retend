# Format staged source files and re-stage any formatter changes.
# NOTE: file lists are passed NUL-delimited via `xargs -0` so paths with
# spaces are handled. Never expand an unquoted `$files` variable here.
staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts')"
if [ -n "$staged" ]; then
  git diff --cached --name-only -z --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' | xargs -0 pnpm exec oxfmt
  git diff --cached --name-only -z --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' | xargs -0 git add --
fi

# `pnpm lint` (oxlint) cannot run on Android/Termux: its JS-plugin support
# allocates a 4 GiB, 2 GiB-aligned block per thread that Android's bionic
# libc cannot satisfy, so oxlint panics with SIGABRT. Skip lint there; it
# still runs on every other platform.
#
# NOTE: When upgrading oxlint, verify that the JS-plugin allocator no longer
# panics on Android (try `oxlint packages/retend-web-devtools`) before
# removing this skip. If it works, re-enable lint on all platforms.
if [ -n "$ANDROID_ROOT" ] || [ "$(node -p 'process.platform' 2>/dev/null)" = "android" ]; then
  echo "Skipping lint on Android (oxlint JS-plugin allocator is unsupported on bionic)"
  exit 0
fi

# Lint only staged files instead of the whole repo. Full-repo `pnpm lint`
# (see the `lint` script in package.json) re-scans thousands of files on
# every commit, which is slow and can exhaust MSYS fork resources on
# Windows and hang the hook.
if [ -n "$staged" ]; then
  git diff --cached --name-only -z --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' | xargs -0 pnpm exec oxlint
fi
