{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./source",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist"
  },
  "include": ["source"],
  "exclude": ["dist", "node_modules", "tests"]
}
